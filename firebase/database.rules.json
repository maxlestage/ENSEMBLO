{
  "rules": {
    "sessions": {
      "$code": {
        ".read": "auth != null && data.exists() && data.child('createdAt').val() > now - 86400000",
        ".validate": "$code.matches(/^[A-Z2-9]{6}$/)",
        ".write": "auth != null && ((!data.exists() && newData.child('creator/id').val() == auth.uid) || (data.exists() && !newData.exists() && data.child('creator/id').val() == auth.uid))",
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() < now + 600000 && newData.val() > now - 600000"
        },
        "seed": {
          ".validate": "newData.isNumber()"
        },
        "creator": {
          "id": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
          "$other": { ".validate": false }
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('sessions').child($code).child('createdAt').val() > now - 86400000",
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          }
        },
        "items": {
          "$itemId": {
            ".write": "auth != null && !data.exists() && newData.child('createdBy').val() == auth.uid && root.child('sessions').child($code).child('participants').child(auth.uid).exists() && root.child('sessions').child($code).child('createdAt').val() > now - 86400000",
            ".validate": "newData.hasChildren(['text', 'createdBy', 'createdAt'])",
            "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 120" },
            "createdBy": { ".validate": "newData.isString()" },
            "createdAt": { ".validate": "newData.isNumber() && newData.val() < now + 600000" },
            "votes": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && root.child('sessions').child($code).child('participants').child(auth.uid).exists() && root.child('sessions').child($code).child('createdAt').val() > now - 86400000",
                ".validate": "newData.isBoolean()"
              }
            },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
